		WeaponDebugRGE: "  RGE: {0} (盗贼伤害: +{1})"
		WeaponDebugPOW: "  POW: {0} (其他伤害: +{1})"
		WeaponDebugAppliedStatBoost: 已应用属性加成: {0} (+{1})
		WeaponDebugAppliedStatBoostLog: 已应用属性加成: {0} (+{1})
		CalCalamityNotDetected: 错误: 未检测到灾厄模组。这些命令需要灾厄模组支持。
		CalIntegrationDisabled: 错误: 灾厄整合已在配置中禁用。
		CalUsage: 用法: /stataria cal <fillrage | filladrenaline | infrage | infadren>
		CalFillRageSuccess: 暴怒已充能至最大值 ({0})。
		CalFillRageError: 错误: 无法访问暴怒数值。
		CalFillAdrenalineSuccess: 肾上腺素已充能至最大值 ({0})。
		CalFillAdrenalineError: 错误: 无法访问肾上腺素数值。
		CalInfRageToggle: 无限暴怒: {0}
		CalInfAdrenalineToggle: 无限肾上腺素: {0}
		CalInfRageToggleLog: 无限暴怒已切换为: {0}
		CalInfAdrenalineToggleLog: 无限肾上腺素已切换为: {0}
		UnknownCalSubcommand: 未知的灾厄子命令。用法: /stataria cal <fillrage | filladrenaline | infrage | infadren>
		TestXPUIAccepted: 经验已接受！
		TestXPUIRejected: 经验已拒绝！
		TestXPUIAllAccepted: 已接受所有经验！
		TestXPUIAllRejected: 已拒绝所有经验！
		TestXPUIShowing: 显示经验验证界面: 包含 {0} 经验来自 '{1}', 提示 {2}/{3}
		UnknownSubcommand: 未知子命令。{0}
		SelfResetMultiplayerDisabled: 本服务器的已禁用玩家自行重置。
		SelfResetWarning1: 警告: 这将完全重置您的 Stataria 进度！
		SelfResetWarning2: 您的所有等级、属性、经验、转生进度和能力都将丢失！
		SelfResetWarning3: 请在 30 秒内再次输入 '/stataria selfreset' 以确认操作。
		SelfResetSuccess: 您的 Stataria 进度已完全重置！
		StatusOn: 开启
		StatusOff: 关闭
		StatusWorking: 正常工作
		StatusErrorsDetected: 发现错误
	}
}

Configs: {
	StatariaConfig: {
		DisplayName: 服务器配置

		generalBalance: {
			Label: 综合平衡
			Tooltip: 配置经验获取、等级上限及其他平衡选项。
		}

		rebirthSystem: {
			Label: 转生系统
			Tooltip: 配置转生机制、等级要求和角色成长奖励系统。
		}

		multiplayerSettings: {
			Label: 多人游戏设置
			Tooltip: 调整经验在多人游戏中如何分配和记录。
		}

		enemyScaling: {
			Label: 敌人数值随动
			Tooltip: 控制敌人强度如何根据玩家等级、多人游戏和精英怪刷新机制进行动态调整。
		}

		statSettings: {
			Label: 属性设置
			Tooltip: 配置各项属性对玩家面板的影响。
		}

		modIntegration: {
			Label: 模组整合联动
			Tooltip: 其他模组支持的设置以及特殊属性效果。
		}

		rebirthAbilities: {
			Label: 转生能力
			Tooltip: 配置玩家可以使用转生点数解锁的特殊能力。
		}

		advanced: {
			Tooltip: 仅限高级玩家配置。请小心操作。
			Label: 高级设置
		}

		xpVerification: {
			Label: 经验验证机制
			Tooltip: 配置异常经验获取的检测与验证系统。
		}

		roleSettings: {
			Label: 职业定位设置
			Tooltip: 配置职业系统的机制、切换成本和各个职业的具体效果。
		}

		socketingSystem: {
			Label: 镶嵌系统
			Tooltip: 配置武器的镶嵌孔系统、核心以及升级成本。
		}

		extraLuckSettings: {
			Tooltip: 配置影响掉落率和其他基于运气机制的强化幸运系统。
			Label: 额外幸运设置
		}
	}

	GeneralBalance: {
		Tooltip: ""

		Headers: {
			General_Balance: 综合平衡
			XP_Multipliers: 经验倍率
			Damage_Calculation: 伤害计算
			Diminishing_Returns: 收益递减机制
			Respec_Settings: 洗点设置
		}

		EnableBossHPXP: {
			Label: 启用首领生命值经验转化
			Tooltip: 无论击杀多少次，都基于首领的最大生命值给予经验。如果不开启，只有首次击杀才给大量经验。
		}

		BonusBossXPIsUnique: {
			Label: 唯一的首领经验加成
			Tooltip: 每个首领只给予一次通关经验加成。如果不开启，则每次击杀都给加成。
		}

		UseFlatBossXP: {
			Label: 使用固定首领经验
			Tooltip: 击败首领时给予固定的经验值，而不是随等级缩放的经验。
		}

		DefaultFlatBossXP: {
			Label: 默认固定首领经验
			Tooltip: 当开启“使用固定首领经验”时，设置击杀首领获得的经验值。
		}

		EnableLevelCap: {
			Label: 启用等级上限
			Tooltip: 开启后玩家无法超过设定的等级限制。如果启用了“动态转生等级上限”，此选项将被忽略。
		}

		LevelCapValue: {
			Label: 等级上限数值
			Tooltip: 设置玩家能达到的最高等级。如果启用了“动态转生等级上限”，此选项将被忽略。
		}

		StatPointsPerLevel: {
			Label: 升级获得的属性点
			Tooltip: 每次升级获得的属性点数量。
		}

		EnableStatResetting: {
			Label: 启用属性重置
			Tooltip: 如果启用，允许玩家在属性面板中重置他们的属性点。
		}

		EnableStatDecrease: {
			Label: 允许单独减少属性点
			Tooltip: 如果启用，允许玩家在属性面板中单独减少已分配的的属性点。
		}

		EnableSkillResetting: {
			Label: 启用技能重置
			Tooltip: 如果启用，允许玩家在技能树面板中重置他们的技能与能力点。
		}

		DamageXP: {
			Label: 伤害经验转化率
			Tooltip: 基于造成的伤害转化为经验的倍率。
		}

		KillXP: {
			Label: 击杀经验转化率
			Tooltip: 基于敌人生命值（包括首领）转化为击杀经验的倍率。
		}

		BossXP: {
			Label: 首领击杀经验加成
			Tooltip: 击杀首领后给予的经验加成 (基于升到下一级所需经验的百分比)。
		}

		UseMultiplicativeDamage: {
			Label: 启用乘法伤害计算
			Tooltip: 开启后，属性提供的伤害将与其他伤害来源相乘，而不是相加。
		}

		LevelScalingFactor: {
			Tooltip: 控制升级所需经验的增长速度。数值越高，经验曲线越陡峭，升级越慢。
			Label: 等级经验缩放因子
		}

		EnableStatPointRecalculation: {
			Tooltip: 开启后，如果您在配置中增加了“升级获得的属性点”，玩家将自动获得补偿属性点。
			Label: 启用属性点重新计算
		}

		EnableDiminishingReturns: {
			Label: 启用收益递减
			Tooltip: 对极高数值的属性点数应用收益递减（投入越多，收益越低）。
		}

		DiminishingReturnsRate: {
			Label: 收益递减率
			Tooltip: 在高数值下属性收益递减的强度。
		}

		EnableRespecCost: {
			Label: 启用洗点消耗
			Tooltip: 重置已分配的属性点需要消耗货币。
		}

		RespecCostType: {
			Label: 洗点消耗类型
			Tooltip: 重置属性点所需的货币类型。
		}

		RespecCostBase: {
			Label: 基础洗点花费
			Tooltip: 重置属性点所需货币的基础数量。
		}

		EnableXPCurve: {
			Label: 启用指数经验曲线
			Tooltip: 使升级难度根据指数曲线逐渐增加。
		}

		XPCurveSteepness: {
			Label: 经验曲线陡峭度
			Tooltip: 经验缩放曲线的陡峭程度。
		}
	}

	RebirthSystem: {
		Tooltip: ""

		Headers: {
			Rebirth_System: 转生系统
			Rebirth_Points: 转生点数
			Ghost_Stats: 幻影属性
		}

		EnableRebirthSystem: {
			Label: 启用转生系统
			Tooltip: 启用转生系统，允许玩家重置等级进度以换取永久的经验获取加成。
		}

		RebirthLevelRequirement: {
			Label: 转生等级要求
			Tooltip: 执行转生所需的最低等级。
		}

		RebirthXPMultiplier: {
			Label: 转生经验倍率
			Tooltip: 每个转生等级提供的经验获取加成。0.5 意味着每次转生增加 50% 经验。
		}

		ResetStatsOnRebirth: {
			Label: 转生时重置属性点
			Tooltip: 如果开启，转生时将重置所有已分配的属性点。
		}

		ResetBossRewardsOnRebirth: {
			Label: 转生时重置首领奖励
			Tooltip: 如果开启，将重置首领奖励的击杀记录，允许您再次获取首杀经验奖励。
		}

		BonusPointsForExcessLevels: {
			Label: 溢出等级奖励点数
			Tooltip: 如果开启，在高于要求等级时进行转生，会给予额外的转生点数。
		}

		ExcessLevelPointMultiplier: {
			Label: 溢出等级点数倍率
			Tooltip: 溢出等级提供奖励点数的倍率。例如，0.5 意味着 10 个溢出等级将提供 5 个额外点数。
		}

		IncreaseLevelRequirement: {
			Label: 递增等级要求
			Tooltip: 如果开启，每次转生所需的等级要求都会增加。
		}

		AdditionalLevelRequirementPerRebirth: {
			Label: 每次转生附加等级要求
			Tooltip: 每次转生后，下一次转生的等级要求增加多少。
		}

		RebirthPointsMultiplier: {
			Label: 转生点数倍率
			Tooltip: 基于转生等级要求奖励转生点数的倍率。
		}

		EnableDynamicRebirthLevelCap: {
			Label: 启用动态转生等级上限
			Tooltip: 如果开启，当前转生周期的最高等级将根据下一次转生的等级要求动态设置。
		}

		DynamicRebirthLevelCapMultiplier: {
			Label: 动态转生等级上限倍率
			Tooltip: 应用于下一次转生等级要求的倍率，用于确定当前周期的动态等级上限。
		}

		EnableRebirthPointRecalculation: {
			Tooltip: 开启后，如果配置中增加了转生点数相关数值，玩家将自动获得补偿的转生点数。
			Label: 启用转生点数重新计算
		}

		EnableGhostStats: {
			Label: 启用幻影属性
			Tooltip: 根据转生进度提供自动的额外属性加成。
		}

		UsePercentageGhostStats: {
			Label: 使用百分比幻影属性
			Tooltip: 如果开启，幻影属性将基于转生等级要求的百分比。如果关闭，则每次转生提供固定数值。
		}

		GhostStatsPercentage: {
			Label: 幻影属性百分比
			Tooltip: 当开启百分比模式时，作为幻影属性添加的转生等级要求的百分比。
		}

		GhostStatsFlatAmount: {
			Label: 幻影属性固定数值
			Tooltip: 当开启固定数值模式时，每次转生添加的幻影属性数值。
		}

		GhostStatsAffectedStats: {
			Label: 受幻影属性影响的属性
			Tooltip:
				'''
				将获得幻影属性加成的属性列表。 
				有效输入: VIT, STR, AGI, INT, LUC, END, POW, DEX, SPR, TCH, RGE, BRD, HLR, CLK
				'''
		}

		EnableRebirthBonusStatPoints: {
			Label: 启用转生额外属性点
			Tooltip: 开启后，每次转生都会增加玩家升级时获得的属性点。
		}

		RebirthStatPointsMultiplier: {
			Label: 转生额外属性点倍率
			Tooltip: 每次转生给予的升级属性点百分比加成。0.25 意味着每次转生增加 25% 的升级属性点。
		}

		EnableRebirthStatPointRecalculation: {
			Label: 启用转生属性点重新计算
			Tooltip: 开启后，如果配置中增加了转生相关的属性点设定，玩家将自动获得补偿。
		}

		EnableProgressiveStatCaps: {
			Label: 启用递进属性上限
			Tooltip: 开启后，属性上限会随着每次转生而提高，允许玩家投入更多的点数。
		}

		ProgressiveStatCapMultiplier: {
			Label: 递进属性上限倍率
			Tooltip: 每次转生增加的属性上限百分比。0.5 意味着每次转生上限增加 50%。
		}

		EnableRebirthAbilities: {
			Label: 启用转生能力
			Tooltip: 开启后，允许玩家消耗转生点数来解锁和使用转生专属能力。
		}
	}

	MultiplayerSettings: {
		Tooltip: ""
		Headers.Multiplayer_Settings: 多人游戏设置

		SplitKillXP: {
			Label: 平分击杀经验
			Tooltip: 开启后，击杀敌人获得的经验将在所有玩家间平分。
		}

		EnableXPProximity: {
			Label: 启用经验共享范围
			Tooltip: 开启后，只有在特定距离内的玩家才能获得击杀经验。
		}

		XPProximityRange: {
			Label: 经验共享范围半径
			Tooltip: 玩家必须在敌人多远（单位：像素）的范围内才能获得击杀经验。
		}

		AllowSelfResetInMultiplayer: {
			Label: 允许在多人游戏中自行重置
			Tooltip: 开启后，允许非管理员玩家在多人游戏中使用 '/stataria selfreset' 命令重置自己的进度。
		}

		AdminSteamIDs: {
			Label: 管理员 Steam ID 列表
			Tooltip: 允许在多人游戏中使用管理员命令的玩家 17 位 Steam ID 列表。
		}
	}

	EnemyScaling: {
		Tooltip: ""

		Headers: {
			Enemy_Scaling: 敌人数值随动
			Multiplayer_Scaling: 多人游戏随动机制
			Elite_Enemies: 精英敌人
			Boss_Scaling: 首领数值随动
			Flat_Scaling: 固定数值随动
			Level_Variation: 等级波动机制
		}

		EnableEnemyScaling: {
			Label: 启用敌人数值随动
			Tooltip: 开启敌人根据玩家等级或人数的动态缩放。关闭时，敌人将使用原版属性。
		}

		EnemyHealthScaling: {
			Label: 敌人生命值随动系数
			Tooltip: 每个玩家等级能让敌人生命值增加多少。数值越高，敌人越难被杀死。
		}

		EnemyDamageScaling: {
			Label: 敌人伤害随动系数
			Tooltip: 每个玩家等级能让敌人伤害增加多少。数值越高，敌人越致命。
		}

		EnemyDefenseScaling: {
			Label: 敌人防御随动系数
			Tooltip: 每个玩家等级能让非首领敌人的防御力增加多少。首领不享受防御随动。
		}

		BossHealthScaling: {
			Label: 首领生命值随动系数
			Tooltip: 应用于首领生命值随动的额外倍率。数值越高，首领越厚。
		}

		BossDamageScaling: {
			Label: 首领伤害随动系数
			Tooltip: 应用于首领伤害随动的额外倍率。数值越高，首领打人越痛。
		}

		ScalingType: {
			Label: 随动类型
			Tooltip: 决定如何计算敌人的数值缩放：0 = 玩家数量 (根据人数给固定加成)，1 = 最高等级 (根据最强玩家)，2 = 平均等级 (根据队伍平均等级)。
		}

		UseProximityForScaling: {
			Label: 根据距离随动
			Tooltip: 开启后，在计算敌人等级时，只考虑附近范围内的玩家。
		}

		ScalingProximityRange: {
			Label: 随动计算范围半径
			Tooltip: 计算动态随动时，考虑玩家的最大距离（单位：像素）。
		}

		EnableEliteEnemies: {
			Label: 启用精英敌人
			Tooltip: 开启后，普通敌人有几率生成为拥有强化属性和抗性的精英变种。
		}

		EliteEnemyChance: {
			Label: 精英敌人生成概率
			Tooltip: 非首领敌人生成为精英怪的几率。
		}

		EliteHealthMultiplier: {
			Label: 精英生命值倍率
			Tooltip: 精英敌人比普通敌人多出多少生命值。
		}

		EliteDamageMultiplier: {
			Label: 精英伤害倍率
			Tooltip: 精英敌人比普通敌人多造成多少伤害。
		}

		EliteDefenseMultiplier: {
			Label: 精英防御倍率
			Tooltip: 精英敌人比普通敌人多出多少防御。
		}

		EliteKnockbackResistance: {
			Label: 精英击退抗性
			Tooltip: 精英敌人的击退抗性强度。0.5 = 减少 50% 的击退效果。
		}

		EliteCriticalHitResistance: {
			Label: 精英暴击抗性
			Tooltip: 对精英敌人造成的暴击伤害会被减少多少。0.25 = 减少 25% 的暴击伤害。
		}

		EliteScaleIncrease: {
			Label: 启用精英体型变大
			Tooltip: 开启后，精英敌人看起来会比普通敌人大。
		}

		EliteScaleMultiplier: {
			Label: 精英体型倍率
			Tooltip: 精英敌人变大的程度。1.15 = 体型增加 15%。
		}

		EnableDefenseCap: {
			Label: 启用防御上限
			Tooltip:
				'''
				开启后，限制敌人防御力随等级增长的上限，防止敌人变得完全打不动。 
				如果您想要更硬核的体验，让高等级敌人拥有极高的防御，请关闭此项。
				'''
		}

		MaxDefenseMultiplier: {
			Label: 最大防御倍率
			Tooltip:
				'''
				当防御随等级增长时，应用于敌人防御的最大倍率（如果开启了防御上限）。 
				在默认值 3 情况下，无论敌人等级多高，其防御力永远不会超过基础值的 3 倍。更高的数值允许敌人变得更硬。
				'''
		}

		LevelsPerPlayer: {
			Label: 每个玩家提供的额外等级
			Tooltip: 当使用基于玩家数量的随动机制（类型 0）时，每个活跃玩家为敌人增加的额外等级数。
		}

		MinimumLevelDifference: {
			Tooltip:
				'''
				当最大等级波动范围较大时，防止敌人生成时的等级比玩家低太多。
				仅适用于随动类型 1（最高等级）。
				'''
			Label: 最小等级差
		}

		EnableMinimumLevelDifference: {
			Tooltip: 开启后，生成的敌人等级不会低于玩家指定数量的等级。
			Label: 启用最小等级差
		}

		MaxLevelVariation: {
			Tooltip: 敌人的等级可以在计算出等级的上下浮动多少个等级（±）。
			Label: 最大等级波动范围
		}

		EnableLevelVariation: {
			Tooltip: 开启后，敌人生成时其等级会在最大等级波动范围内随机浮动。
			Label: 启用等级波动
		}

