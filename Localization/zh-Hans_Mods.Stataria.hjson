	Advanced: {
		XPBlacklistedNPCs: {
			Tooltip: 击杀后不会给予经验的 NPC 名称或 ID 列表 (例如: Zombie 或僵尸的 ID 3)
			Label: 经验黑名单 NPC
		}

		ScalingBlacklistedNPCs: {
			Tooltip: 不受敌人数值动态缩放系统影响的 NPC 名称或 ID 列表 (例如: 'Blood Crawler' 或 65)。
			Label: 数值随动黑名单 NPC
		}

		EnableCustomPlayerHP: {
			Label: 启用自定义玩家生命/法力值 (双精度浮点)
			Tooltip:
				'''
				允许玩家的最大生命值与法力值通过自定义双精度浮点数机制突破 21.4 亿的上限限制。
				启用后，你单帧内所能承受的最大致死伤害将提高到 10 亿。
				警告：此选项不会停用原版的生命值爱心/法力值星星 HUD。然而，由于每个爱心将代表 50,000,000 HP，原版 HUD 将显得静止/冻结。此外，如果绘制大量法力值星星，游戏将会变得极其卡顿，导致画面冻结以及严重的 CPU 性能下降。我强烈建议使用自定义状态栏 HUD。
				'''
		}

		EnableCustomPlayerDamage: {
			Label: 启用自定义玩家伤害 (双精度浮点)
			Tooltip:
				'''
				允许玩家攻击拥有自定义生命值上限的怪物时，造成的单次伤害突破 21.4 亿上限。
				注意：在伤害超过 20 亿时，将会隐藏原版的伤害数字跳字，转而显示我们自定义格式的浮空文字。
				'''
		}

		EnableCustomMobHP: {
			Label: 启用自定义怪物生命值 (双精度浮点)
			Tooltip:
				'''
				允许怪物与 Boss 的最大生命值突破 21.4 亿限制。其在原版系统中的生命值将被强行限制在 15 亿 (MAX_SAFE_HEALTH) 以防止数据溢出导致实体消失。
				警告：任何在单帧内造成的伤害超过 15 亿的攻击都会导致怪物直接死亡 (绕过自定义生命值计算)，不过玩家的正常攻击很少能达到这一高度。
				'''
		}

		Headers: {
			XP_Blacklist: 经验黑名单
			Scaling_Blacklist: 数值随动黑名单
			Custom_Limit_Toggles: 自定义上限开关 (双精度浮点)
		}

		Tooltip: ""
	}

	XPVerification: {
		Tooltip: ""
		Headers.XP_Verification: 经验验证机制

		EnableXPVerification: {
			Label: 启用经验验证
			Tooltip: 开启后，单次获得可疑的大量经验值时将弹窗要求确认。
		}

		BaseXPThreshold: {
			Label: 基础经验阈值
			Tooltip: 触发验证的基础经验量。此数值会随您的等级和转生次数增加。
		}

		LevelScalingFactor: {
			Label: 等级阈值缩放系数
			Tooltip: 每个玩家等级使经验阈值增加多少。
		}

		RebirthScalingFactor: {
			Label: 转生阈值缩放系数
			Tooltip: 每个转生等级使经验阈值增加多少。
		}

		RelativeXPThreshold: {
			Label: 相对经验阈值
			Tooltip: 当获取的经验超过升级所需经验的此百分比时，触发验证。例如，1.5 意味着相当于下级所需经验 150% 的经验获取量。
		}

		RebirthRelativeThresholdReduction: {
			Label: 转生对相对阈值的降低
			Tooltip: 每次转生降低多少相对阈值。这允许高转生角色获取大量经验而不被频繁验证打扰。
		}

		WhitelistedSources: {
			Label: 经验来源白名单
			Tooltip:
				'''
				免受验证的经验来源。您可以添加如 'Boss'，将放行所有名称中包含 'Boss' 的经验来源。
				常见来源包括: 'Boss Bonus', 'Kill', 'Damage', 'Melee', 'Projectile'。
				'''
		}
	}

