			Label: 玩家指示器透明度
		}

		ShowRebirthTitle: {
			Tooltip: 当您有转生等级时，在等级指示器下方显示您的转生头衔。
			Label: 显示转生头衔
		}

		ShowLevelIndicator: {
			Tooltip: 在角色头顶上显示您当前的等级，在多人游戏中对所有人可见。
			Label: 显示玩家等级指示器
		}

		ShowBossXPPopups: {
			Tooltip: 当获取经验的跳字开启时，是否显示击杀首领的经验跳字。
			Label: 显示首领经验跳字
		}

		ShowKillXPPopups: {
			Tooltip: 当获取经验的跳字开启时，是否显示击杀敌人的经验跳字。
			Label: 显示击杀经验跳字
		}

		ShowDamageXPPopups: {
			Tooltip: 当获取经验的跳字开启时，是否显示造成伤害转化经验的跳字。
			Label: 显示伤害经验跳字
		}

		ShowXPGainPopups: {
			Tooltip: 整体控制是否显示经验获取的跳字。如果关闭，则完全不显示。
			Label: 开启经验获取跳字
		}

		ShowXPBarAbovePlayer: {
			Tooltip: 获取经验时，在角色头顶显示悬浮的经验条。
			Label: 显示玩家头顶经验条
		}

		BossBarYOffsetPercent: {
			Label: 首领血条 Y 轴偏移 (%)
			Tooltip: 首领血条的垂直位置 (占屏幕高度的百分比)
		}

		MaxVisibleBossBars: {
			Label: 最大可见首领血条数
			Tooltip: 屏幕上同时显示的首领血条最大数量。
		}

		MiniBossNPCIDs: {
			Label: 迷你首领 NPC ID
			Tooltip: 视为迷你首领的 NPC ID 列表（它们将显示首领血条）。
		}

		ForcedBossNPCIDs: {
			Label: 强制显示首领血条 NPC ID
			Tooltip: 始终视为首领的 NPC ID 列表。
		}

		ExcludedBossNPCIDs: {
			Label: 排除显示首领血条 NPC ID
			Tooltip: 永远“不”为其显示首领血条的 NPC ID 列表（此项优先级最高）。
		}

		EnableLevelUpSound: {
			Label: 开启升级音效
			Tooltip: 升级音效的配置。
		}

		StretchXPBarToBottom: {
			Tooltip: 将经验条拉伸到屏幕底部。
			Label: 拉伸经验条到底部
		}

		EnableVanillaHUDFloatingRallyBar: {
			Label: 启用原版HUD悬浮拉力条
			Tooltip: 在使用游戏原版生命栏时，于玩家头顶绘制包含拉力虚血的生命条。
		}
	}
}

