Keybinds: {
	"Toggle Stataria UI.DisplayName": Переключить интерфейс Stataria
	"AGI Teleport.DisplayName": Телепорт
	"Divine Intervention.DisplayName": Божественное вмешательство
}

ResourceDisplaySets.StatariaResourceDisplaySet.DisplayName: Stataria

Commands: {
	StatariaCommands: {
