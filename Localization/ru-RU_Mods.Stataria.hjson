	Advanced: {
		XPBlacklistedNPCs: {
			Tooltip: Имена или ID NPC, за которых не дают опыт при убийстве (например, Zombie или 3 для зомби).
			Label: Черный Список Опыта (NPC)
		}

		ScalingBlacklistedNPCs: {
			Tooltip: Имена или ID NPC, которые не усиливаются системой масштабирования (например, 'Blood Crawler' или 65).
			Label: Черный Список Масштабирования
		}

		EnableCustomPlayerHP: {
			Label: Включить кастомное здоровье/ману игрока (Двойная точность)
			Tooltip:
				'''
				Позволяет максимальному запасу здоровья и маны игрока превышать 2.14 миллиарда с помощью кастомного слоя двойной точности.
				При включении порог выживаемости при единовременном получении урона увеличивается до 1 миллиарда.
				ВНИМАНИЕ: Это не отключает ванильный HUD сердец/звезд. Однако, поскольку каждое сердце будет представлять 50 000 000 HP, ванильный HUD будет казаться застывшим/статичным. Кроме того, при отрисовке большого количества звезд маны игра начнет сильно лагать, вызывая зависания и сильное падение производительности процессора. Настоятельно рекомендую использовать кастомную панель ресурсов.
				'''
		}

		EnableCustomPlayerDamage: {
			Label: Включить кастомный урон игрока (Двойная точность)
			Tooltip:
				'''
				Позволяет урону игрока превышать 2.14 миллиарда при атаке мобов с кастомным здоровьем двойной точности.
				ПРИМЕЧАНИЕ: Скрывает ванильный текст урона при ударах свыше 2 миллиардов, заменяя его форматированными всплывающими сообщениями.
				'''
		}

		EnableCustomMobHP: {
			Label: Включить кастомное здоровье мобов (Двойная точность)
			Tooltip:
				'''
				Позволяет мобам и боссам иметь здоровье свыше 2.14 миллиарда. Ограничивает их ванильное здоровье до 1.5 миллиарда (MAX_SAFE_HEALTH) для предотвращения ошибок переполнения.
				ВНИМАНИЕ: Любой удар силой более 1.5 миллиарда урона за один кадр мгновенно уничтожит моба (в обход кастомного здоровья), хотя обычный урон игрока редко достигает таких значений.
				'''
		}

		Headers: {
			XP_Blacklist: Черный Список Опыта
			Scaling_Blacklist: Черный Список Масштабирования
			Custom_Limit_Toggles: Кастомные ограничения (Двойная точность)
		}

		Tooltip: ""
	}

