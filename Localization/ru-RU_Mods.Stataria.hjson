		StatusErrorsDetected: ОБНАРУЖЕНЫ ОШИБКИ
	}
}

Configs: {
	StatariaConfig: {
		DisplayName: Настройки Сервера

		generalBalance: {
			Label: Основной Баланс
			Tooltip: Настройка получения опыта, лимита уровней и других параметров баланса.
		}

		rebirthSystem: {
			Label: Система Перерождений
			Tooltip: Настройка механик перерождения, требований к уровню и системы наград.
		}

		multiplayerSettings: {
			Label: Настройки Мультиплеера
			Tooltip: Настройка распределения и учета опыта между игроками в сетевой игре.
		}

		enemyScaling: {
			Label: Масштабирование Врагов
			Tooltip: Контроль усиления врагов в зависимости от уровня игрока, мультиплеера и спавна элитных противников.
		}

		statSettings: {
			Label: Настройки Характеристик
			Tooltip: Настройка влияния каждой характеристики на атрибуты игрока.
		}

		modIntegration: {
			Label: Интеграция Модов
			Tooltip: Настройки поддержки других модов и их специальных характеристик.
		}

		rebirthAbilities: {
			Label: Способности Перерождения
			Tooltip: Настройка специальных способностей, открываемых за Очки Перерождения.
		}

		advanced: {
			Tooltip: Только для опытных пользователей. Будьте осторожны.
			Label: Продвинутые Настройки
		}

		xpVerification: {
			Label: Проверка Опыта
			Tooltip: Настройка системы обнаружения и проверки аномального получения опыта.
		}

		roleSettings: {
			Label: Настройки Ролей
			Tooltip: Настройка механики системы ролей, их стоимости и эффектов.
		}

		socketingSystem: {
			Label: Система Инкрустации (Гнезда)
			Tooltip: Настройка системы гнезд для оружия, ядер и стоимости их улучшения.
		}

		extraLuckSettings: {
			Tooltip: Настройка расширенной системы удачи, влияющей на шанс выпадения предметов и другие механики.
			Label: Дополнительные Настройки Удачи
		}
	}

	GeneralBalance: {
		Tooltip: ""

		Headers: {
			General_Balance: Основной Баланс
			XP_Multipliers: Множители Опыта
			Damage_Calculation: Расчет Урона
			Diminishing_Returns: Убывающая Доходность
			Respec_Settings: Настройки Сброса Навыков
		}

		EnableBossHPXP: {
			Label: Опыт от макс. здоровья Босса
			Tooltip: Опыт выдается на основе макс. здоровья босса при каждом убийстве. Иначе - фиксированный бонус один раз.
		}

		BonusBossXPIsUnique: {
			Label: Уникальный Бонус за Босса
			Tooltip: Каждый босс дает бонусный опыт только один раз. Иначе бонус выдается всегда.
		}

		UseFlatBossXP: {
			Label: Фиксированный Опыт за Босса
			Tooltip: Дает боссам фиксированное количество бонусного опыта вместо масштабируемого.
		}

		DefaultFlatBossXP: {
			Label: Стандартный Опыт за Босса (Фикс.)
			Tooltip: Устанавливает количество опыта за боссов, если включен фиксированный опыт.
		}

		EnableLevelCap: {
			Label: Включить Лимит Уровня
			Tooltip: Не дает поднимать уровень выше заданного. Игнорируется, если включен динамический лимит перерождения.
		}

		LevelCapValue: {
			Label: Значение Лимита Уровня
			Tooltip: Устанавливает максимальный уровень. Игнорируется, если включен динамический лимит перерождения.
		}

		StatPointsPerLevel: {
			Label: Очки Характеристик за Уровень
			Tooltip: Количество очков характеристик, получаемых за повышение уровня.
		}

		EnableStatResetting: {
			Label: Разрешить сброс характеристик
			Tooltip: Если включено, позволяет игрокам сбрасывать очки характеристик на панели характеристик.
		}

		EnableStatDecrease: {
			Label: Разрешить уменьшение отдельных характеристик
			Tooltip: Если включено, позволяет игрокам уменьшать отдельные очки характеристик на панели характеристик.
		}

		EnableSkillResetting: {
			Label: Разрешить сброс способностей
			Tooltip: Если включено, позволяет игрокам сбрасывать очки дерева умений/способностей.
		}

		DamageXP: {
			Label: Опыт за Урон
			Tooltip: Множитель опыта на основе нанесенного урона.
		}

		KillXP: {
			Label: Опыт за Убийство
			Tooltip: Множитель опыта за убийство врагов на основе их здоровья (включая боссов).
		}

		BossXP: {
			Label: Опыт за Босса
			Tooltip: Бонусный опыт за убийство босса (% от опыта, необходимого для следующего уровня).
		}

		UseMultiplicativeDamage: {
			Label: Мультипликативный Урон
			Tooltip: Если включено, урон от характеристик перемножается с другими источниками урона вместо сложения.
		}

		LevelScalingFactor: {
			Tooltip: Контролирует скорость роста требований к опыту с каждым уровнем. Большие значения означают более медленную прокачку.
			Label: Фактор Масштабирования Уровня
		}

		EnableStatPointRecalculation: {
			Tooltip: Если включено, игроки автоматически получат дополнительные очки, если 'Очки за Уровень' будут увеличены в конфиге.
			Label: Включить Перерасчет Очков Характеристик
		}

		EnableDiminishingReturns: {
			Label: Включить Убывающую Доходность
			Tooltip: Применяет убывающую доходность (штраф эффективности) к экстремально высоким значениям характеристик.
		}

		DiminishingReturnsRate: {
			Label: Степень Убывающей Доходности
			Tooltip: Насколько сильно штрафуются характеристики на высоких значениях.
		}

		EnableRespecCost: {
			Label: Включить Стоимость Сброса
			Tooltip: Требует валюту для сброса распределенных очков характеристик.
		}

		RespecCostType: {
			Label: Тип Валюты для Сброса
			Tooltip: Предмет (валюта), требуемый для сброса характеристик.
		}

		RespecCostBase: {
			Label: Базовая Стоимость Сброса
			Tooltip: Базовое количество валюты, требуемое для сброса.
		}

		EnableXPCurve: {
			Label: Включить Кривую Опыта
			Tooltip: Делает повышение уровня экспоненциально сложнее с каждым уровнем.
		}

		XPCurveSteepness: {
			Label: Крутизна Кривой Опыта
			Tooltip: Крутизна кривой масштабирования требований к опыту.
		}
	}

	RebirthSystem: {
		Tooltip: ""

		Headers: {
			Rebirth_System: Система Перерождений
			Rebirth_Points: Очки Перерождения
			Ghost_Stats: Призрачные Характеристики
		}

		EnableRebirthSystem: {
			Label: Включить Систему Перерождений
			Tooltip: Включает систему, позволяющую игрокам сбросить прогресс ради постоянных бонусов к опыту.
		}

		RebirthLevelRequirement: {
			Label: Требуемый Уровень Перерождения
			Tooltip: Минимальный уровень, необходимый для совершения перерождения.
		}

		RebirthXPMultiplier: {
			Label: Множитель Опыта от Перерождения
			Tooltip: Бонус к получаемому опыту за каждый уровень перерождения. 0.5 означает +50% опыта за перерождение.
		}

		ResetStatsOnRebirth: {
			Label: Сброс Характеристик при Перерождении
			Tooltip: Если включено, все распределенные очки характеристик будут сброшены при перерождении.
		}

		ResetBossRewardsOnRebirth: {
			Label: Сброс Наград за Боссов при Перерождении
			Tooltip: Если включено, прогресс наград за боссов будет сброшен, позволяя получить бонусный опыт за них снова.
		}

		BonusPointsForExcessLevels: {
			Label: Бонусные Очки за Лишние Уровни
			Tooltip: Если включено, перерождение на уровне выше требуемого дает бонусные Очки Перерождения.
		}

		ExcessLevelPointMultiplier: {
			Label: Множитель Очков за Лишние Уровни
			Tooltip: Множитель бонусных очков за лишние уровни. Например, 0.5 означает, что 10 лишних уровней дадут 5 доп. очков.
		}

		IncreaseLevelRequirement: {
			Label: Увеличивать Требование Уровня
			Tooltip: Если включено, требуемый для перерождения уровень растет с каждым новым перерождением.
		}

		AdditionalLevelRequirementPerRebirth: {
			Label: Доп. Уровни за Каждое Перерождение
			Tooltip: На сколько уровней возрастает требование перерождения с каждым разом.
		}

		RebirthPointsMultiplier: {
			Label: Множитель Очков Перерождения
			Tooltip: Множитель начисляемых Очков Перерождения, основанный на требованиях к перерождению.
		}

		EnableDynamicRebirthLevelCap: {
			Label: Включить Динамический Лимит Уровня
			Tooltip: Если включено, максимальный уровень динамически ограничивается на основе требования к следующему перерождению.
		}

		DynamicRebirthLevelCapMultiplier: {
			Label: Множитель Динамического Лимита
			Tooltip: Множитель, применяемый к требованию следующего перерождения для определения лимита уровня в текущем цикле.
		}

		EnableRebirthPointRecalculation: {
			Tooltip: Если включено, игроки автоматически получат дополнительные Очки Перерождения при изменении конфигов.
			Label: Перерасчет Очков Перерождения
		}

		EnableGhostStats: {
			Label: Включить Призрачные Характеристики
			Tooltip: Дает автоматические бонусы характеристик в зависимости от прогресса перерождений.
		}

		UsePercentageGhostStats: {
			Label: Процентные Призрачные Характеристики
			Tooltip: Если включено, характеристики зависят от процента требуемого уровня перерождения. Иначе дается фикс. количество.
		}

		GhostStatsPercentage: {
			Label: Процент Призрачных Характеристик
			Tooltip: Процент от требования к уровню перерождения, добавляемый как призрачные характеристики.
		}

		GhostStatsFlatAmount: {
			Label: Фиксированные Призрачные Характеристики
			Tooltip: Фиксированное количество призрачных характеристик, добавляемое за каждое перерождение.
		}

		GhostStatsAffectedStats: {
			Label: Затронутые Призрачные Характеристики
			Tooltip:
				'''
				Список характеристик, получающих призрачные бонусы. 
				Доступные: VIT, STR, AGI, INT, LUC, END, POW, DEX, SPR, TCH, RGE, BRD, HLR, CLK
				'''
		}

		EnableRebirthBonusStatPoints: {
			Label: Включить Бонусные Очки за Перерождение
			Tooltip: Если включено, каждое перерождение увеличивает количество очков характеристик за уровень.
		}

		RebirthStatPointsMultiplier: {
			Label: Множитель Бонусных Очков за Перерождение
			Tooltip: Процентный бонус к очкам за уровень при каждом перерождении. 0.25 означает +25% очков за перерождение.
		}

		EnableRebirthStatPointRecalculation: {
			Label: Перерасчет Очков от Перерождения
			Tooltip: Если включено, игроки автоматически получат дополнительные очки при увеличении соответствующих настроек.
		}

		EnableProgressiveStatCaps: {
			Label: Прогрессивные Лимиты Характеристик
			Tooltip: Если включено, лимиты характеристик увеличиваются с каждым перерождением, позволяя вкладывать больше очков.
		}

		ProgressiveStatCapMultiplier: {
			Label: Множитель Прогрессивного Лимита
			Tooltip: Процентное увеличение лимита характеристик за перерождение. 0.5 означает +50% к лимиту за перерождение.
		}

		EnableRebirthAbilities: {
			Label: Включить Способности Перерождения
			Tooltip: Позволяет игрокам открывать и использовать специальные способности за Очки Перерождения.
		}
	}

	MultiplayerSettings: {
		Tooltip: ""
		Headers.Multiplayer_Settings: Настройки Мультиплеера

		SplitKillXP: {
			Label: Разделение Опыта за Убийства
			Tooltip: Если включено, опыт за убийства делится между всеми игроками поровну.
		}

		EnableXPProximity: {
			Label: Опыт по Близости
			Tooltip: Если включено, только игроки, находящиеся рядом с убитым врагом, получают опыт.
		}

		XPProximityRange: {
			Label: Радиус Получения Опыта
			Tooltip: Максимальная дистанция (в пикселях) от убитого врага для получения опыта.
		}

		AllowSelfResetInMultiplayer: {
			Label: Разрешить Сброс Себя в Мультиплеере
			Tooltip: Позволяет обычным игрокам сбрасывать свой прогресс Stataria командой '/stataria selfreset' на сервере.
		}

		AdminSteamIDs: {
			Label: Steam ID Администраторов
			Tooltip: Список 17-значных Steam ID игроков, которым разрешено использовать команды администратора в мультиплеере.
		}
	}

	EnemyScaling: {
		Tooltip: ""

		Headers: {
			Enemy_Scaling: Масштабирование Врагов
			Multiplayer_Scaling: Масштабирование в Мультиплеере
			Elite_Enemies: Элитные Враги
			Boss_Scaling: Масштабирование Боссов
			Flat_Scaling: Фикс. Масштабирование
			Level_Variation: Вариация Уровней
		}

		EnableEnemyScaling: {
			Label: Включить Масштабирование Врагов
			Tooltip: Включает усиление врагов в зависимости от уровня игроков. Если выключено, используются ванильные статы.
		}

		EnemyHealthScaling: {
			Label: Масштабирование Здоровья Врагов
			Tooltip: Насколько увеличивается здоровье врагов за каждый уровень игрока.
		}

		EnemyDamageScaling: {
			Label: Масштабирование Урона Врагов
			Tooltip: Насколько увеличивается урон врагов за каждый уровень игрока.
		}

		EnemyDefenseScaling: {
			Label: Масштабирование Защиты Врагов
			Tooltip: Увеличение защиты обычных врагов за каждый уровень игрока. Боссы не получают это усиление.
		}

		BossHealthScaling: {
			Label: Масштабирование Здоровья Боссов
			Tooltip: Дополнительный множитель для масштабирования здоровья боссов.
		}

		BossDamageScaling: {
			Label: Масштабирование Урона Боссов
			Tooltip: Дополнительный множитель для масштабирования урона боссов.
		}

		ScalingType: {
			Label: Тип Масштабирования
			Tooltip: Как рассчитывается усиление: 0 = По кол-ву игроков (фикс. бонус за игрока), 1 = По высшему уровню (сильнейшему игроку), 2 = По среднему уровню.
		}

		UseProximityForScaling: {
			Label: Близость для Масштабирования
			Tooltip: Учитывает только игроков в пределах радиуса при расчете уровня врагов.
		}

		ScalingProximityRange: {
			Label: Радиус Масштабирования
			Tooltip: Максимальная дистанция (в пикселях) для учета игроков в расчетах масштабирования.
		}

		EnableEliteEnemies: {
			Label: Включить Элитных Врагов
			Tooltip: Включает спавн элитных врагов с улучшенными статами и сопротивлениями.
		}

